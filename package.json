{
  "name": "markdown-formatter-spo",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "gulp bundle",
    "clean": "gulp clean",
    "demo": "node demo/build-demo.js",
    "harness": "node harness/build.js",
    "harness:drive": "node harness/build.js && node harness/drive.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "package": "gulp bundle --ship && gulp package-solution --ship",
    "serve": "gulp serve",
    "site": "node scripts/build-site.js",
    "test": "node scripts/run-tests.js",
    "test:spfx": "gulp test"
  },
  "dependencies": {
    "@microsoft/sp-component-base": "1.21.1",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-lodash-subset": "1.21.1",
    "@microsoft/sp-office-ui-fabric-core": "1.21.1",
    "@microsoft/sp-property-pane": "1.21.1",
    "@microsoft/sp-webpart-base": "1.21.1",
    "@pnp/logging": "4.16.0",
    "@pnp/sp": "4.16.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "4.2.3",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-table-of-contents": "1.2.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.21.1",
    "@microsoft/eslint-plugin-spfx": "1.21.1",
    "@microsoft/rush-stack-compiler-4.7": "0.1.0",
    "@microsoft/sp-build-web": "1.21.1",
    "@microsoft/sp-module-interfaces": "1.21.1",
    "@rushstack/eslint-config": "4.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/webpack-env": "~1.18.0",
    "ajv": "^6.12.5",
    "dotenv": "^17.4.1",
    "esbuild": "^0.25.0",
    "eslint": "8.57.0",
    "gulp": "4.0.2",
    "sass": "^1.77.0",
    "typescript": "5.3.3"
