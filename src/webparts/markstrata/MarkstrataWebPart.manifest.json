{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "74aecd51-7619-4ca6-b81a-6c670d6098b3",
  "alias": "MarkstrataWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportsFullBleed": true,
  "supportedHosts": [
    "SharePointWebPart",
    "TeamsPersonalApp",
    "TeamsTab",
    "SharePointFullPage"
  ],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
      "group": {
        "default": "Content"
      },
      "title": {
        "default": "Markstrata"
      },
      "description": {
        "default": "Markdown with GitHub, Obsidian and VS Code themes - readable code blocks, callouts, diagrams and math."
      },
      "officeFabricIconFontName": "InkingTool",
      "properties": {
        "contentSource": "manual",
        "themeFamily": "vscode",
        "colorMode": "light",
        "contentWidth": "comfortable",
        "density": "compact",
        "textSize": "normal",
        "codeSize": "normal",
        "showThemeSwitcher": false,
        "enableSyntaxHighlighting": true,
        "showCodeHeader": true,
        "showLineNumbers": true,
        "wrapCodeLines": false,
        "enableMermaid": true,
        "enableMath": true,
        "enableAnchors": true,
        "tocMaxLevel": 3,
        "showSourceInfo": true,
        "enableVersionHistory": true,
        "enableAutoRefresh": false,
        "allowHtml": false,
        "tocPosition": "inline",
        "toolbarVisibility": "always",
        "showPrintButton": true
      },
      "iconImageUrl": "data:image/svg+xml;base64,"
    }
  ]
}
