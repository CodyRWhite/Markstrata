dist/
lib/
temp/
release/
solution/
sharepoint/solution/
teams/TeamsSPFxApp.zip
*.sppkg

# Dependencies
node_modules/

# Generated during the build
*.scss.ts
*.css.ts
*.tsbuildinfo
*.js.map
*.css.map

# Preview output (npm run demo)
demo/dist/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pfx
*.cer

# Editors and operating systems
.vscode/
